# Absolute path to the canonical LifeOS vault on the host.
# The supported container runs as UID/GID 10001:10001, so this node vault must grant
# that identity read/write/execute access. Prefer a dedicated node vault or an explicit ACL.
LIFEOS_VAULT_PATH=/srv/lifeos/vault

# File containing only the bearer token. Keep this outside the vault.
LIFEOS_TOKEN_FILE=/srv/lifeos/secrets/service-token

# Stable attribution used for proposal submissions through this service instance.
LIFEOS_ACTOR_ID=home-node

# Safe default: publish only on host loopback.
LIFEOS_PUBLISH_ADDRESS=127.0.0.1
LIFEOS_PORT=8000
LIFEOS_ALLOWED_HOST=127.0.0.1:*

# For VPN/LAN access, explicitly change both publish address and allowed Host.
# Example only:
# LIFEOS_PUBLISH_ADDRESS=0.0.0.0
# LIFEOS_ALLOWED_HOST=lifeos.example.internal:*
