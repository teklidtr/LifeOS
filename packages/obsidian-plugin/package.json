{
  "name": "lifeos-obsidian-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "compile": "tsc -p tsconfig.json",
    "test": "npm run compile && node --test --test-concurrency=1 --test-force-exit dist-test/test/*.test.js",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "test:artifact": "node --test test/build-artifact.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "typescript": "7.0.2"
  }
}
